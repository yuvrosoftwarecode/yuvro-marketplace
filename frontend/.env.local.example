# ===========================================================================
# yuvro-marketplace Frontend — Local Environment Variables
# VITE_* vars are baked into the JS bundle at build time.
# ===========================================================================

# Backend API URL
VITE_BACKEND_API_BASE_URL=http://localhost:8004/api
VITE_YHUB_BACKEND_API_BASE_URL=https://backend-hub-dev.yuvro.ai/api

# App metadata
VITE_APP_NAME=yuvro-marketplace
VITE_DEPLOY_ENV=local
