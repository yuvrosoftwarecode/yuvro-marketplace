# ===========================================================================
# yuvro-marketplace Frontend — Dev Environment Variables
# VITE_* vars are baked into the JS bundle at build time.
# ===========================================================================

# Backend API URL
VITE_BACKEND_API_BASE_URL=https://backend-marketplace.yuvro.ai/api
VITE_YHUB_BACKEND_API_BASE_URL=https://backend-hub-dev.yuvro.ai/api

# App metadata
VITE_APP_NAME=yuvro-marketplace
VITE_DEPLOY_ENV=dev
