# PRODUCTION SECRETS TEMPLATE - DO NOT COMMIT
# Copy this file to .env.prod-secrets and fill in your actual production credentials
# .env.prod-secrets is gitignored and loaded alongside .env.prod

# AWS S3 Credentials (Production)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database Credentials (Production RDS)
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secret Key - Use strong production key
SECRET_KEY=

# Google OAuth (Production)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# GitHub Container Registry Token
GITHUB_TOKEN=

# AWS Account ID (for EKS)
AWS_ACCOUNT_ID=

# AWS Region
AWS_REGION=
