# PRODUCTION ENVIRONMENT
SECRET_KEY=prod-yuvro-marketplace-secret-key-replace-with-strong-key
DEBUG=False
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes
APP_NAME=yuvro-marketplace
JWT_SECRET_KEY=prod-yuvro-marketplace-jwt-secret-replace-with-strong-key

# Backend URLs (production)
YHUB_BACKEND_API_BASE_URL=https://api.yhub.yuvro.ai/api

# Frontend URL
FRONTEND_URL=https://ymarketplace.yuvro.ai

# Allowed hosts and CORS
ALLOWED_HOSTS=ymarketplace.yuvro.ai,www.ymarketplace.yuvro.ai,api.ymarketplace.yuvro.ai
CORS_ALLOWED_ORIGINS=https://ymarketplace.yuvro.ai,https://www.ymarketplace.yuvro.ai
CSRF_TRUSTED_ORIGINS=https://ymarketplace.yuvro.ai,https://www.ymarketplace.yuvro.ai

# AWS S3 (Production)
AWS_S3_REGION_NAME=ap-south-1
AWS_STORAGE_BUCKET_NAME=yuvro-prod

# Database
DB_HOST=ymarketplace-rds-prod.c123456.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ymarketplace_prod_db
DB_USER=ymarketplace_prod_user

# Google OAuth (will be in secrets if needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=yuvro-marketplace-backend-prod
OTEL_SERVICE_VERSION=1.0.0

PROMETHEUS_METRICS_PORT=9001

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=contact@yuvro.ai
EMAIL_LOGO_URL=

# Security
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Frontend Configuration
VITE_API_URL=https://api.ymarketplace.yuvro.ai
