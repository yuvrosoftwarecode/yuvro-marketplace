# DEV ENVIRONMENT - Loaded alongside .env.dev-secrets
SECRET_KEY=yuvro-marketplace-dev-secret-key
DEBUG=false
DEPLOY_ENV=dev
APP_NAME=yuvro-marketplace
JWT_SECRET_KEY=yuvro-marketplace-dev-jwt-secret

# Backend URLs
YHUB_BACKEND_API_BASE_URL=https://backend-hub-dev.yuvro.ai/api

# Frontend URL
FRONTEND_URL=https://marketplace.yuvro.ai

# Allowed hosts and CORS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=https://*.yuvrolabs.com,https://*.yuvro.ai,http://localhost:3004
CSRF_TRUSTED_ORIGINS=https://*.yuvrolabs.com,https://*.yuvro.ai

# AWS S3
AWS_S3_REGION_NAME=ap-south-1

# Google OAuth (leave empty, will be in secrets if needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=yuvro-marketplace-backend-dev
OTEL_SERVICE_VERSION=1.0.0

PROMETHEUS_METRICS_PORT=9001

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=contact@yuvro.ai
EMAIL_LOGO_URL=
