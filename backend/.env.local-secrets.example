# LOCAL SECRETS TEMPLATE - DO NOT COMMIT
# Copy this file to .env.local-secrets and fill in your actual credentials
# .env.local-secrets is gitignored and loaded alongside .env.local

# AWS / MinIO Credentials
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database Credentials
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secret Key
SECRET_KEY=

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
